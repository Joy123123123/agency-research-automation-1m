# API Keys & Environment Configuration
# Copy this file: cp config/api_keys.env.example config/api_keys.env
# NEVER commit api_keys.env — it's in .gitignore

# ========================
# AI APIs
# ========================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# ========================
# Email APIs
# ========================
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=agency@yourdomain.com
SENDGRID_FROM_NAME=Md Jamil Islam

# Gmail SMTP — FREE alternative to SendGrid (pure Python, no API key needed!)
# Setup: myaccount.google.com → Security → 2-Step Verification → App Passwords → Mail
GMAIL_EMAIL=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# ========================
# Auto-Scheduler (0=off, 1=auto-run daily pipeline)
# ========================
AUTO_SCHEDULER=0

# ========================
# CRM / Database
# ========================
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_LEADS=Leads
AIRTABLE_TABLE_CAMPAIGNS=Campaigns

NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# ========================
# Scraping APIs
# ========================
SCRAPERAPI_KEY=your_scraperapi_key_here
PROXYCRAWL_TOKEN=your_proxycrawl_token

# ========================
# Social Media APIs
# ========================
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password

# ========================
# App Settings
# ========================
APP_ENV=development
LOG_LEVEL=INFO
MAX_LEADS_PER_DAY=500
EMAIL_DAILY_LIMIT=200
RESEARCH_DELAY_SECONDS=2
